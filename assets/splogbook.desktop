[Desktop Entry]
Name=SPLogbook
GenericName=Amateur Radio Logbook
GenericName[pl]=Dziennik Krótkofalarski
Comment=Modern amateur radio logging software with CAT, DX cluster, and awards tracking
Comment[pl]=Nowoczesny dziennik krótkofalarski ze sterowaniem CAT, klastrem DX i dyplomami
Exec=splogbook %f
Icon=splogbook
