<component type="desktop-application">
  <id>io.github.sp6ina.SPLogbook</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>SPLogbook</name>
  <summary>Amateur radio logging and station automation workstation</summary>

  <developer id="io.github.sp6ina">
    <name>Mariusz Woźniak (SP6INA)</name>
  </developer>

  <description>
    <p>
      SPLogbook is a logging and station automation workstation for amateur
      radio operators. It keeps the QSO log in a local SQLite database and
      talks to radios over the network, so it works on a sandboxed desktop
      without direct access to device nodes.
    </p>
    <p>Main capabilities:</p>
    <ul>
      <li>QSO logging, search and statistics with ADIF and Cabrillo import and export</li>
      <li>CAT radio control through rigctld/rotctld, TCI, FlexRadio, Kenwood LAN and native serial protocols</li>
      <li>Awards tracking, DX cluster, callbook lookups and LoTW/eQSL/ClubLog upload</li>
      <li>Station configuration, backups, propagation data and satellite tracking</li>
      <li>Seven user interface languages</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.sp6ina.SPLogbook.desktop</launchable>

  <provides>
    <binary>SPLogbook</binary>
  </provides>

  <url type="homepage">https://github.com/sp6ina/SPLogbook</url>
  <url type="bugtracker">https://github.com/sp6ina/SPLogbook/issues</url>
  <url type="vcs-browser">https://github.com/sp6ina/SPLogbook</url>

  <categories>
    <category>HamRadio</category>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>hamradio</keyword>
    <keyword>amateur radio</keyword>
    <keyword>logbook</keyword>
    <keyword>qso</keyword>
    <keyword>cat</keyword>
    <keyword>dx cluster</keyword>
    <keyword>adif</keyword>
    <keyword>cabrillo</keyword>
    <keyword>lotw</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="1.2.0" date="2026-10-26" type="stable">
      <description>
        <p>Public stable release of SPLogbook.</p>
      </description>
    </release>
  </releases>
</component>
