#
# Minimal postrm for the SPLogbook DEB. It refreshes desktop integration
# caches after removal and never deletes user data, QSO databases, WAL/SHM
# files, configuration, exports or backups from the user's home directory.

set -e

refresh_desktop_database() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        if ! update-desktop-database -q /usr/share/applications; then
            echo "splogbook: warning: update-desktop-database failed" >&2
        fi
    fi
}

refresh_icon_cache() {
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        if [ -d /usr/share/icons/hicolor ]; then
            if ! gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor; then
                echo "splogbook: warning: gtk-update-icon-cache failed" >&2
            fi
        fi
    fi
}

case "${1:-}" in
    remove|purge)
        refresh_desktop_database
        refresh_icon_cache
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        ;;
esac

exit 0
