#
# Minimal, idempotent and non-interactive postinst for the SPLogbook DEB.
# Only desktop integration caches are refreshed, and only when the official
# helper tool is already present. No network, no user data, no escalation.

set -e

refresh_desktop_database() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        if ! update-desktop-database -q /usr/share/applications; then
            echo "splogbook: warning: update-desktop-database failed" >&2
        fi
    fi
}

refresh_icon_cache() {
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        if ! gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor; then
            echo "splogbook: warning: gtk-update-icon-cache failed" >&2
        fi
    fi
}

case "${1:-}" in
    configure)
        refresh_desktop_database
        refresh_icon_cache
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
